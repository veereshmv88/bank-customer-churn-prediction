{
  "model_name": "Gradient Boosting",
  "model_version": "1.0.0",
  "random_state": 42,
  "classification_threshold": 0.28,
  "default_threshold": 0.5,
  "train_samples": 8000,
  "test_samples": 2000,
  "features": [
    "CreditScore",
    "Age",
    "Tenure",
    "Balance",
    "NumOfProducts",
    "HasCrCard",
    "IsActiveMember",
    "EstimatedSalary",
    "BalanceSalaryRatio",
    "EngagementProductInteraction",
    "AgeTenureInteraction",
    "ProductDensityIndicator",
    "MultiProductRisk",
    "Geography_France",
    "Geography_Germany",
    "Geography_Spain",
    "Gender_Female",
    "Gender_Male"
  ],
  "risk_bands": {
    "Low Risk": {
      "min": 0.0,
      "max": 25.0,
      "color": "#10B981",
      "badge": "bg-emerald-500/20 text-emerald-400"
    },
    "Medium Risk": {
      "min": 25.0,
      "max": 50.0,
      "color": "#F59E0B",
      "badge": "bg-amber-500/20 text-amber-400"
    },
    "High Risk": {
      "min": 50.0,
      "max": 100.0,
      "color": "#EF4444",
      "badge": "bg-rose-500/20 text-rose-400"
    }
  },
  "selection_rationale": "Gradient Boosting demonstrated superior discriminant capability across 5-fold cross-validation, achieving top PR-AUC (0.6924) and ROC-AUC (0.8607) with robust generalizability and well-calibrated probabilities on tabular customer churn data."
}